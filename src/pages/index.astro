---
import cars from "../assets/cars.json";
import Layout from "../layouts/Layout.astro";

const years = [...new Set(cars.map((c) => c.year))].sort((a, b) => a - b);
---

<Layout title="Voitures par année">
  <h1>Voitures par année</h1>
  <nav aria-label="Années">
    <ul>
      {
        years.map((y) => (
          <li>
            <a href={`/cars/year/${y}`}>Année : {y}</a>
          </li>
        ))
      }
    </ul>
  </nav>
  <p><a href="/penguins">Manchots par espèce</a></p>
  <p><a href="/diamonds">Diamants</a></p>
</Layout>
