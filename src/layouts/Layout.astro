---
import "../styles/global.css";
import penguins from "../assets/penguins.json";

interface Props {
  title: string;
}
const { title } = Astro.props;

const speciesList = [...new Set(penguins.map(({ species }) => species))];
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const pages = [
  { href: "/", label: "Accueil" },
  { href: "/penguins", label: "Manchots" },
  { href: "/diamonds", label: "Diamants" },
  { href: "/penguins/slider", label: "Tous les manchots" },
  ...speciesList.map((species) => ({ href: `/penguins/${species}`, label: species })),
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <label for="page-navigation">Page</label>
      <select id="page-navigation" aria-label="Navigation principale">
        {
          pages.map((page) => (
            <option value={page.href} selected={currentPath === page.href}>
              {page.label}
            </option>
          ))
        }
      </select>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<script>
  document.querySelector("#page-navigation")?.addEventListener("change", (event) => {
    const value = (event.target as HTMLSelectElement).value;
    location.pathname = value;
  });
</script>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  .site-header {
    align-items: center;
    border-bottom: 1px solid #d9e2e8;
    background: #ffffff;
    display: flex;
    gap: 0.75rem;
    padding: 0.75rem 1.5rem;
  }

  select {
    border: 1px solid #b8cbd2;
    border-radius: 0.375rem;
    color: #176b87;
    font: inherit;
    padding: 0.5rem 2rem 0.5rem 0.75rem;
  }
</style>
